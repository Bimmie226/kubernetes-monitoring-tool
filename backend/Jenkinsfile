pipeline {
    agent {
        label 'single-node'
    }

    stages {
        stage('Build') {
            // when {
            //     changeset "backend/**"
            // }
            steps {
                sh(
                    script: 
                    '''
                        cd backend/app

                        python3.12 -m venv .venv
                        . .venv/bin/activate

                        python -m pip install --upgrade pip
                        pip install -r requirements.txt
                    ''', label: "Build stage"
                )
            }
        }

        stage('Deploy') {
            // when {
            //     changeset "backend/**"
            // } 
            steps {
                sh(
                    script: 
                    '''
                        cd backend
                        . .venv/bin/activate
                        python3.12 -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload 
                    ''', label: "Deploy Stage"
                )
            }
        }
    }
}