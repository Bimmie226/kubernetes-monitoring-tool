pipeline {
    agent {
        label 'single-node'
    }

    stages {
        stage('Build') {
            steps {
                sh(
                    script: '''
                        chown -R luongvn. .
                        sudo su luongvn -c "docker build -t luongngocvu/k8s-tool-be:latest ./backend"
                    ''',
                    label: "Build stage"
                )
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([
                    usernamePassword (
                        credentialsId: 'dockerhub-user', 
                        usernameVariable: 'DOCKER_USER', 
                        passwordVariable: 'DOCKER_TOKEN'
                    )
                ]) {
                    sh(
                        script: '''
                            sudo su luongvn -c "echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin"
                            sudo su luongvn -c "docker push luongngocvu/k8s-tool-be:latest"
                            sudo su luongvn -c "docker logout"
                        ''', 
                        label: "Push image stage"
                    )
                }
            }
        }   

        stage('Deploy') {
            withCredentials([
                file(
                    credentialsId: 'k8s-monitor-tool-be'
                    variable: 'ENV_FILE'
                )
            ])
            steps {
                sh(
                    script: '''
                        sudo su luongvn -c "docker rm -f k8s-tool-be"
                        sudo su luongvn -c "docker run --name k8s-tool-be -dp 8000:8000 --network minikube --env-file "$ENV_FILE" -e K8S_CONFIG_MODE=kubeconfig -e KUBERNETES_PATH=/config/kubeconfig -v /home/luongvn/kubeconfig-container.yaml:/config/kubeconfig:ro luongngocvu/k8s-tool-be:latest"
                    ''', 
                    label: "Deploy stage"
                )
            }
        }
    }
}