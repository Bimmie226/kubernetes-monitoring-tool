pipeline{
    agent{
        label "single-node"
    }
    stages{
        stage("Deploy"){
            when {
                changeset "frontend/**"
            }
            steps {
                sh(
                    script: '''
                        chown -R luongvn. . 
                        sudo su luongvn -c "python3.12 -m venv .venv; . .venv/bin/activate; nohup python -m http.server 5500 --bind 0.0.0.0 --directory frontend > nohup-fe.out 2>&1 &"
                    ''', 
                    label: "Deploy stage"
                )
            }
        }
    }
}